# Google AI / Vertex AI Configuration
# For Google AI Studio (recommended for prototyping):
GEMINI_API_KEY=your_gemini_api_key_here

# For Google Cloud Vertex AI (enterprise production):
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# Default Gemini model
GEMINI_MODEL=gemini-2.5-flash

# ClickHouse Cloud / MCP Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=rosetta_board
CLICKHOUSE_SECURE=False

# Live Web Intelligence (Parallel API)
PARALLEL_API_KEY=your_parallel_api_key_here
